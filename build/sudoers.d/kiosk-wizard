# Narrowly-scoped passwordless sudo for the first-boot setup wizard, which
# runs as the unprivileged "kiosk" user and needs a handful of privileged,
# one-time actions (join Wi-Fi, set hostname, toggle systemd units, reboot).
#
# The wizard's HTTP server binds to 127.0.0.1 only - it is reachable exclusively
# from the kiosk's own local Chromium on the kiosk's own attached screen, never
# over the network. Physical/console access to this device already implies
# this level of control, so this is an appropriate tradeoff for a single-purpose
# appliance image, not a general-purpose multi-user host.
kiosk ALL=(root) NOPASSWD: /usr/bin/nmcli
kiosk ALL=(root) NOPASSWD: /usr/bin/hostnamectl
kiosk ALL=(root) NOPASSWD: /usr/bin/systemctl reboot
kiosk ALL=(root) NOPASSWD: /usr/bin/systemctl enable *
kiosk ALL=(root) NOPASSWD: /usr/bin/systemctl disable *
kiosk ALL=(root) NOPASSWD: /usr/sbin/chpasswd
kiosk ALL=(root) NOPASSWD: /usr/local/sbin/set-boot-rotation.py

# kiosk-config-mqtt.service (build/scripts/kiosk_config_mqtt.py) needs this
# one privileged action to apply a dashboard-URL change live, without a
# reboot - restarting the chromium kiosk service picks up the new URL from
# kiosk_config.ini on its next launch.
kiosk ALL=(root) NOPASSWD: /usr/bin/systemctl --no-block restart kiosk.service
