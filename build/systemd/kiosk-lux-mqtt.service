[Unit]
Description=Kiosk Lux -> MQTT
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kiosk
Group=kiosk
ExecStart=/usr/bin/python3 /home/kiosk/kiosk_lux_mqtt.py
WorkingDirectory=/home/kiosk
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
