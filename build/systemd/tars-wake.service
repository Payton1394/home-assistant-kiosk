[Unit]
Description=TARS wake word ("TARS" / "Hey TARS") -> Scarth Wall Panel add-on
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=kiosk
WorkingDirectory=/home/kiosk/tars-wake
# The shared microphone (tars_mic) is defined in the kiosk user's ~/.asoundrc.
Environment=HOME=/home/kiosk
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/kiosk/tars-wake/.venv/bin/python /home/kiosk/tars-wake/tars_wake.py
Restart=always
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
